# EditorConfig — menjaga gaya penulisan seragam antar editor
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: dua spasi di akhir baris berarti "hard break", jangan dipangkas
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
